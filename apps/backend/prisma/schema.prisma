datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum WatchlistType {
  CUSTOM
  AI_GENERATED
}

enum TransactionType {
  BUY
  SELL
}

enum SentimentType {
  POSITIVE
  NEGATIVE
  NEUTRAL
}

enum ChatRole {
  user
  assistant
}

enum TradingMode {
  PAPER
  LIVE
}

enum ExplanationStyle {
  BEGINNER
  ADVANCED
}

model User {
  id                 String            @id @default(uuid())
  email              String            @unique
  passwordHash       String?           @map("password_hash")
  googleId           String?           @map("google_id")
  fullName           String            @map("full_name")
  avatarUrl          String?           @map("avatar_url")
  tradingMode        TradingMode       @default(PAPER) @map("trading_mode")
  liveTradingEnabled Boolean           @default(false) @map("live_trading_enabled")
  cryptoTradingMode        TradingMode       @default(PAPER) @map("crypto_trading_mode")
  cryptoLiveTradingEnabled Boolean           @default(false) @map("crypto_live_trading_enabled")
  explanationStyle   ExplanationStyle  @default(BEGINNER) @map("explanation_style")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  tokens                 RefreshToken[]
  portfolios             Portfolio[]
  watchlists             Watchlist[]
  chatSessions           ChatSession[]
  brokerCredentials      BrokerCredential[]
  brokerOrders           BrokerOrder[]
  wallet                 Wallet?
  cryptoPortfolios       CryptoPortfolio[]
  cryptoWatchlists       CryptoWatchlist[]
  cryptoBrokerCredential CryptoBrokerCredential?
  cryptoBrokerOrders     CryptoBrokerOrder[]
  passwordResetTokens    PasswordResetToken[]

  @@map("users")
}

enum WalletTransactionType {
  TOPUP
  PAPER_TRADE_DEBIT
  PAPER_TRADE_CREDIT
}

enum WalletTransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  balance   Float    @default(0.0)
  currency  String   @default("INR")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id                String                  @id @default(uuid())
  walletId          String                  @map("wallet_id")
  type              WalletTransactionType
  amount            Float
  status            WalletTransactionStatus @default(SUCCESS)
  description       String?
  razorpayOrderId   String?                 @map("razorpay_order_id")
  razorpayPaymentId String?                 @map("razorpay_payment_id")
  razorpaySignature String?                 @map("razorpay_signature")
  referenceTradeId  String?                 @map("reference_trade_id")
  createdAt         DateTime                @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model Stock {
  id        String   @id @default(uuid())
  symbol    String   @unique
  name      String
  sector    String
  industry  String
  exchange  String
  currency  String   @default("INR")
  updatedAt DateTime @updatedAt @map("updated_at")

  prices          StockPrice[]
  fundamentals    StockFundamental[]
  holdings        Holding[]
  transactions    Transaction[]
  watchlistItems  WatchlistItem[]
  newsLinks       NewsStockLink[]
  recommendations AiRecommendation[]

  @@index([name])
  @@index([symbol, name])
  @@map("stocks")
}

model StockPrice {
  id        String   @id @default(uuid())
  stockId   String   @map("stock_id")
  timestamp DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  interval  String   @default("1d")

  stock Stock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@index([stockId, timestamp])
  @@map("stock_prices")
}

model StockFundamental {
  id            String   @id @default(uuid())
  stockId       String   @map("stock_id")
  peRatio       Float    @map("pe_ratio")
  pbRatio       Float    @map("pb_ratio")
  roe           Float
  roce          Float
  eps           Float
  debtToEquity  Float    @map("debt_to_equity")
  marketCap     Float    @map("market_cap")
  fiscalPeriod  String   @map("fiscal_period")
  updatedAt     DateTime @updatedAt @map("updated_at")

  stock Stock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@map("stock_fundamentals")
}

model Portfolio {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  holdings     Holding[]
  transactions Transaction[]

  @@map("portfolios")
}

model Holding {
  id          String   @id @default(uuid())
  portfolioId String   @map("portfolio_id")
  stockId     String   @map("stock_id")
  quantity    Float
  avgBuyPrice Float    @map("avg_buy_price")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  stock     Stock     @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@map("holdings")
}

model Transaction {
  id          String          @id @default(uuid())
  portfolioId String          @map("portfolio_id")
  stockId     String          @map("stock_id")
  type        TransactionType
  quantity    Float
  price       Float
  executedAt  DateTime        @default(now()) @map("executed_at")

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  stock     Stock     @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model Watchlist {
  id        String        @id @default(uuid())
  userId    String        @map("user_id")
  name      String
  type      WatchlistType @default(CUSTOM)
  createdAt DateTime      @default(now()) @map("created_at")

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WatchlistItem[]

  @@map("watchlists")
}

model WatchlistItem {
  id          String   @id @default(uuid())
  watchlistId String   @map("watchlist_id")
  stockId     String   @map("stock_id")
  addedAt     DateTime @default(now()) @map("added_at")

  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  stock     Stock     @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@map("watchlist_items")
}

model NewsArticle {
  id                  String        @id @default(uuid())
  title               String
  source              String
  url                 String
  publishedAt         DateTime      @map("published_at")
  sentiment           SentimentType
  sentimentConfidence Float         @map("sentiment_confidence")
  summary             String

  stockLinks NewsStockLink[]

  @@map("news_articles")
}

model NewsStockLink {
  id            String @id @default(uuid())
  newsArticleId String @map("news_article_id")
  stockId       String @map("stock_id")
  relevanceScore Float  @map("relevance_score")

  article NewsArticle @relation(fields: [newsArticleId], references: [id], onDelete: Cascade)
  stock   Stock       @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@map("news_stock_links")
}

model AiRecommendation {
  id                 String   @id @default(uuid())
  stockId            String   @map("stock_id")
  overallScore       Float    @map("overall_score")
  confidence         Float
  riskRating         String   @map("risk_rating")
  recommendationText String   @map("recommendation_text")
  reasoning          Json
  dataSources        Json     @map("data_sources")
  generatedAt        DateTime @default(now()) @map("generated_at")

  stock Stock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@map("ai_recommendations")
}

model ChatSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  createdAt DateTime @default(now()) @map("created_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  role      ChatRole
  content   String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model BrokerCredential {
  id                    String    @id @default(uuid())
  userId                String    @map("user_id")
  brokerName            String    @default("ANGEL_ONE") @map("broker_name")
  clientCode            String?   @map("client_code")
  encryptedPin          String?   @map("encrypted_pin")
  encryptedTotpSecret   String?   @map("encrypted_totp_secret")
  encryptedApiKey       String    @map("encrypted_api_key")
  encryptedApiSecret    String?   @map("encrypted_api_secret")
  encryptedJwtToken     String?   @map("encrypted_jwt_token")
  encryptedRefreshToken  String?   @map("encrypted_refresh_token")
  encryptedFeedToken    String?   @map("encrypted_feed_token")
  sessionExpiresAt      DateTime? @map("session_expires_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, brokerName])
  @@map("broker_credentials")
}

model BrokerOrder {
  id              String          @id @default(uuid())
  userId          String          @map("user_id")
  symbol          String
  transactionType TransactionType @map("transaction_type")
  quantity        Float
  price           Float
  orderType       String          @default("MARKET") @map("order_type")
  tradingMode     TradingMode     @map("trading_mode")
  brokerOrderId   String?         @map("broker_order_id")
  status          String          @default("PENDING")
  statusMessage   String?         @map("status_message")
  executedAt      DateTime        @default(now()) @map("executed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("broker_orders")
}

model CryptoAsset {
  id        String   @id @default(uuid())
  symbol    String   @unique
  name      String
  category  String?
  addedAt   DateTime @default(now()) @map("added_at")

  prices          CryptoPrice[]
  holdings        CryptoHolding[]
  transactions    CryptoTransaction[]
  watchlistItems  CryptoWatchlistItem[]

  @@index([name])
  @@index([symbol, name])
  @@map("crypto_assets")
}

model CryptoPrice {
  id            String   @id @default(uuid())
  cryptoAssetId String   @map("crypto_asset_id")
  timestamp     DateTime
  open          Float
  high          Float
  low           Float
  close         Float
  volume        Float
  interval      String   @default("1d")

  cryptoAsset CryptoAsset @relation(fields: [cryptoAssetId], references: [id], onDelete: Cascade)

  @@index([cryptoAssetId, timestamp])
  @@map("crypto_prices")
}

model CryptoPortfolio {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String   @default("Crypto Portfolio")
  createdAt DateTime @default(now()) @map("created_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  holdings     CryptoHolding[]
  transactions CryptoTransaction[]

  @@map("crypto_portfolios")
}

model CryptoHolding {
  id                String   @id @default(uuid())
  cryptoPortfolioId String   @map("crypto_portfolio_id")
  cryptoAssetId     String   @map("crypto_asset_id")
  quantity          Float
  avgBuyPrice       Float    @map("avg_buy_price")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  cryptoPortfolio CryptoPortfolio @relation(fields: [cryptoPortfolioId], references: [id], onDelete: Cascade)
  cryptoAsset     CryptoAsset     @relation(fields: [cryptoAssetId], references: [id], onDelete: Cascade)

  @@index([cryptoPortfolioId, cryptoAssetId])
  @@map("crypto_holdings")
}

model CryptoTransaction {
  id                String          @id @default(uuid())
  cryptoPortfolioId String          @map("crypto_portfolio_id")
  cryptoAssetId     String          @map("crypto_asset_id")
  type              TransactionType
  quantity          Float
  price             Float
  executedAt        DateTime        @default(now()) @map("executed_at")

  cryptoPortfolio CryptoPortfolio @relation(fields: [cryptoPortfolioId], references: [id], onDelete: Cascade)
  cryptoAsset     CryptoAsset     @relation(fields: [cryptoAssetId], references: [id], onDelete: Cascade)

  @@index([cryptoPortfolioId, executedAt])
  @@map("crypto_transactions")
}

model CryptoWatchlist {
  id        String        @id @default(uuid())
  userId    String        @map("user_id")
  name      String
  type      WatchlistType @default(CUSTOM)
  createdAt DateTime      @default(now()) @map("created_at")

  user  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CryptoWatchlistItem[]

  @@map("crypto_watchlists")
}

model CryptoWatchlistItem {
  id                String   @id @default(uuid())
  cryptoWatchlistId String   @map("crypto_watchlist_id")
  cryptoAssetId     String   @map("crypto_asset_id")
  addedAt           DateTime @default(now()) @map("added_at")

  cryptoWatchlist CryptoWatchlist @relation(fields: [cryptoWatchlistId], references: [id], onDelete: Cascade)
  cryptoAsset     CryptoAsset     @relation(fields: [cryptoAssetId], references: [id], onDelete: Cascade)

  @@unique([cryptoWatchlistId, cryptoAssetId])
  @@map("crypto_watchlist_items")
}

model CryptoBrokerCredential {
  id                 String    @id @default(uuid())
  userId             String    @unique @map("user_id")
  brokerName         String    @default("COINDCX") @map("broker_name")
  encryptedApiKey    String    @map("encrypted_api_key")
  encryptedApiSecret String    @map("encrypted_api_secret")
  sessionExpiresAt   DateTime? @map("session_expires_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("crypto_broker_credentials")
}

model CryptoBrokerOrder {
  id              String          @id @default(uuid())
  userId          String          @map("user_id")
  symbol          String
  transactionType TransactionType @map("transaction_type")
  quantity        Float
  price           Float
  orderType       String          @default("MARKET") @map("order_type")
  tradingMode     TradingMode     @map("trading_mode")
  brokerOrderId   String?         @map("broker_order_id")
  status          String          @default("PENDING")
  statusMessage   String?         @map("status_message")
  executedAt      DateTime        @default(now()) @map("executed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("crypto_broker_orders")
}
