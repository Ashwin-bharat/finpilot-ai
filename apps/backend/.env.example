# Server Port
PORT=4000

# Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finpilot?schema=public"

# Redis Connection
REDIS_URL="redis://localhost:6379"

# Auth Secrets & Encryption
JWT_SECRET="your-jwt-secret-key-change-in-production"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-key-change-in-production"
ENCRYPTION_KEY="" # 32-byte hex string (64 characters) for AES-256-GCM broker credential encryption
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/google/callback"

# Email Service (Resend - https://resend.com, optional: console logging fallback if empty)
RESEND_API_KEY=""
MAIL_FROM="FinPilot AI <onboarding@resend.dev>"

# Market Data Provider (yahoo | mock)
MARKET_DATA_PROVIDER="yahoo"

# News Provider (marketaux | mock)
NEWS_PROVIDER="marketaux"
MARKETAUX_API_KEY=""

# AI Integrations
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
ANTHROPIC_API_KEY="your-anthropic-api-key"

# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# Broker Integration (Documentation only — users submit their own credentials via Settings UI)
ANGEL_ONE_API_KEY=""
ANGEL_ONE_CLIENT_CODE=""
ANGEL_ONE_PIN=""
ANGEL_ONE_TOTP_SECRET=""
CRYPTO_API_KEY=""
CRYPTO_API_SECRET=""
