# Database Connection
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/finpilot_db?schema=public"

# Redis Connection
REDIS_URL="redis://localhost:6379"

# Authentication Secrets & Security
JWT_SECRET="your-jwt-secret-key-change-in-production"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-key-change-in-production"
ENCRYPTION_KEY="" # 32-byte hex string (64 characters) for AES-256-GCM broker credential encryption
FRONTEND_URL="http://localhost:3000"

# Google OAuth 2.0
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/google/callback"

# Email Service (Resend - https://resend.com, optional: console logging fallback if empty)
RESEND_API_KEY=""
MAIL_FROM="FinPilot AI <onboarding@resend.dev>"

# Frontend Client API URL (Next.js public variable)
# When using Next.js proxy rewrite: /api/v1
# When backend is hosted on a separate domain: https://your-backend.railway.app/api/v1
NEXT_PUBLIC_API_URL="/api/v1"

# Market Data Provider (yahoo | mock)
MARKET_DATA_PROVIDER="yahoo"

# News Provider (marketaux | mock)
NEWS_PROVIDER="marketaux"
MARKETAUX_API_KEY=""

# AI Integrations
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
ANTHROPIC_API_KEY="your-anthropic-api-key"

# Payment Gateway (Razorpay Test Mode)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Broker Integration (Documentation only — users submit their own credentials via Settings UI)
ANGEL_ONE_API_KEY=""
ANGEL_ONE_CLIENT_CODE=""
ANGEL_ONE_PIN=""
ANGEL_ONE_TOTP_SECRET=""
CRYPTO_API_KEY=""
CRYPTO_API_SECRET=""
